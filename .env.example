DATABASE_URL="postgresql://user:password@host-pooler:5432/adunkasih?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/adunkasih?sslmode=require"
AUTH_SECRET="generate-with-npx-auth-secret"

# Optional: sets the password for the default admin account created by
# `node prisma/seed-reference-data.mjs`. If omitted, the script generates a
# random one and prints it once to the console.
ADMIN_SEED_PASSWORD=
